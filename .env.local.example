NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Optional: only needed for `npm run seed` (demo data script).
# Get from Supabase Studio → Project Settings → API → service_role secret.
# DO NOT commit this anywhere or expose to client. Server/script use only.
SUPABASE_SERVICE_ROLE_KEY=

# 결제 안내에 표시되는 정보 (서버 사이드만 읽음). /billing 페이지가 사용.
BILLING_BANK_NAME=토스뱅크
BILLING_ACCOUNT_NUMBER=1000-0000-0000
BILLING_ACCOUNT_HOLDER=장유승
BILLING_CONTACT_EMAIL=sales@caseboard.kr

# 슈퍼관리자(=서비스 운영자) 이메일. 콤마로 여러개 가능.
# 이 이메일로 로그인한 사용자만 /admin/subscriptions 접근 가능.
# (입금 확인 후 한 번 클릭으로 active/연장 처리)
SUPER_ADMIN_EMAILS=caseboard443@gmail.com

# Optional: Sentry error monitoring. Leave blank to disable.
NEXT_PUBLIC_SENTRY_DSN=
# Optional: source map upload at build (Vercel build env only).
# SENTRY_ORG=
# SENTRY_PROJECT=
# SENTRY_AUTH_TOKEN=
